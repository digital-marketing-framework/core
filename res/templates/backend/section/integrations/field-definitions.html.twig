{% extends "module.html.twig" %}

{% block section %}

    <h2>Field Definitions</h2>

    <p>
        Field definitions describe the fields a system offers, so that they can be picked and
        labelled wherever a field is chosen. A context is one such set of fields, and it is the
        sum of its sources below &mdash; each one correcting the ones above it.
    </p>

    {% embed 'list/list.html.twig' with {
        route: 'page.integrations',
        listAction: 'field-definitions',
        icon: { path: 'PKG:digital-marketing-framework/core/res/assets/icons/record-field-definition.svg' },
        create: storageAvailable,
        useActions: false,
        useBulkActions: false,
        listLabel: 'Field contexts',
        noResultsText: 'No field contexts found.',
        showLabel: false,
        list
    } %}

        {% block createItem %}
            <form method="post" action="{{ uri('page.integrations.field-definitions-create') }}">
                <div class="form-row justify-content-between">
                    <div class="form-group">
                        <input type="hidden" name="returnUrl" value="{{ permanentUri }}" />
                        <div class="input-group">
                            <span class="btn btn-default disabled" style="min-width:8rem">create</span>

                            <input type="text" name="newContextIdentifier" placeholder="context identifier" pattern="[A-Za-z0-9][A-Za-z0-9._-]*" title="Letters, digits, dots, dashes and underscores" class="btn btn-default" autocomplete="off" data-1p-ignore/>

                            <button type="submit" class="btn btn-default">
                                {{ include('t3-icon.html.twig', {name:'plus',class:'add'}) }}
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        {% endblock %}

        {% block tableHeadCustom %}
            <th>Integration</th>
            <th>Type</th>
            <th>Name</th>
            <th>Context identifier</th>
            <th class="nowrap">Fields</th>
            <th>Sources</th>
        {% endblock %}

        {% block tableRowCustom %}
            {# Named once per group: the rows after the first leave the cell empty. #}
            <th scope="row" class="nowrap">
                {{ item.firstOfGroup ? (item.integration ?? item.type) : '' }}
            </th>
            <td class="nowrap">{{ item.integration ? item.type : '' }}</td>
            <td class="col-title">{{ item.route }}</td>
            <td><code>{{ item.id }}</code></td>
            <td class="nowrap">{{ item.fieldCount }}</td>
            <td>
                <table class="table table-borderless mb-0">
                    {% for source in item.sources %}
                        <tr>
                            <td class="p-1">
                                {% if source.declaredInCode %}
                                    <em>declared in code</em>
                                {% else %}
                                    <code>{{ source.folder }}</code>
                                {% endif %}
                            </td>
                            <td class="p-1 nowrap">
                                {{ source.stored or source.declaredInCode ? source.fieldCount : '&mdash;'|raw }}
                            </td>
                            <td class="p-1 col-control nowrap">
                                {% if source.declaredInCode %}
                                    {# Nothing to act on: no file exists and the fields belong to the package. #}
                                {% elseif not source.stored %}
                                    {% if source.writable %}
                                        <a href="{{ uri('page.integrations.field-definitions-create', {contextIdentifier:item.id, folder:source.folder, returnUrl:permanentUri}) }}"
                                           class="btn btn-default btn-sm" title="Create a definition file in {{ source.folder }}">
                                            {{ include('t3-icon.html.twig', {name:'plus',class:'add'}) }}
                                        </a>
                                    {% endif %}
                                {% elseif source.writable %}
                                    <a href="{{ uri('page.integrations.field-definitions-edit', {id:item.id, folder:source.folder, returnUrl:permanentUri}) }}"
                                       class="btn btn-default btn-sm" title="Edit the definitions in {{ source.folder }}">
                                        {{ include('t3-icon.html.twig', {name:'open'}) }}
                                    </a>
                                    <a href="{{ uri('page.integrations.field-definitions-delete', {list:{(item.id):item.id}, folder:source.folder, returnUrl:permanentUri}) }}"
                                       class="btn btn-default btn-sm" title="Delete the definition file in {{ source.folder }}"
                                       data-confirm="Delete the field definitions for {{ item.id }} in {{ source.folder }}?">
                                        {{ include('t3-icon.html.twig', {name:'delete', class:'edit-delete'}) }}
                                    </a>
                                {% else %}
                                    <a href="{{ uri('page.integrations.field-definitions-edit', {id:item.id, folder:source.folder, returnUrl:permanentUri}) }}"
                                       class="btn btn-default btn-sm" title="View the definitions in {{ source.folder }}">
                                        {{ include('t3-icon.html.twig', {name:'file-view'}) }}
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </td>
        {% endblock %}
    {% endembed %}
{% endblock %}
