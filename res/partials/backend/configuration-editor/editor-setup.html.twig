<p><em>Loading <strong>{{ title }} UI</strong>, this might take a few seconds...</em></p>

<details>
    <summary>Click to show raw text configuration below.<br>You can try editing the settings manually, useful when something goes terribly wrong:</summary>
    <div style="padding-top: 1rem">
        {# A save action belongs to the section, which is usually named after the document type it
           edits. A section named differently, or serving more than one, passes its own route. #}
        {% set saveRoute = saveRoute ?? ('page.' ~ documentType ~ '.save') %}
        <form method="post" action="{{ uri(saveRoute) }}">
            <div>
                <p>
                    <button class="btn btn-default btn-sm" value="save" title="Save" type="submit">
                        Save
                    </button>
                    <a data-role="close" class="btn btn-default btn-sm" title="Close" href="{{ returnUri }}">
                        Close
                    </a>
                </p>
            </div>
            <div>
                {% if documentIdentifier %}<input type="hidden" name="documentIdentifier" value="{{ documentIdentifier }}" />{% endif %}
                {% for name, value in hiddenFields ?? {} %}<input type="hidden" name="{{ name }}" value="{{ value }}" />{% endfor %}
                {% if returnUrl is defined and returnUrl %}<input type="hidden" name="returnUrl" value="{{ returnUrl }}" />{% endif %}
                {{ include('configuration-editor/textarea.html.twig', { config, documentType, document }) }}
            </div>
        </form>
    </div>
</details>

<div id="stage-container"></div>
