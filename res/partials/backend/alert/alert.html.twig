{% set classMap = {0:'info', 1:'warning', 2:'danger'} %}
{% set iconMap = {0:'info', 1:'exclamation', 2:'close'} %}
{% set class = classMap[alert.type] %}
{% set icon = iconMap[alert.type] %}
{# Error pages include this partial with a literal array that has no actions #}
{% set actions = alert.actions|default([]) %}
<div class="callout callout-{{ class }}">
    <div class="media">
        <div class="media-left">
            <span class="icon-emphasized">
                {{ include('t3-icon.html.twig', {name:icon}) }}
            </span>
        </div>
        <div class="media-body">
            <div class="callout-title">{{ alert.title }}</div>
            <div class="callout-body">
                {{ alert.content }}
            </div>
            {% if actions is not empty %}
                <div class="mt-2">
                    {% for action in actions %}
                        <a class="btn btn-default btn-sm" href="{{ uri(action.route, action.arguments) }}">
                            {% if action.icon %}{{ include('t3-icon.html.twig', { name: action.icon }) }}{% endif %}
                            {{ action.label }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
